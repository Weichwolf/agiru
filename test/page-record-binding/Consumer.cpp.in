#include "fixture/page/RecordBinding.h"
#include "platform/Field.h"
#include "type/Text.h"

#include <cstdio>
#include <exception>

int main() {
  try {
    agiru::Fixture::RecordBinding_Page first;
    agiru::Fixture::RecordBinding_Page second;
    first.Rec.TableName = "First";
    second.Rec.TableName = "Second";
    if (first.Choose() != 2 || first.Rec.Class != agiru::platform::FieldClass::FlowFilter) {
      return 1;
    }
    if (first.ChooseWithShadow() != 1 || first.Rec.Class != agiru::platform::FieldClass::FlowField) {
      return 1;
    }
    if (first.ChoosePrevious() != 0 || first.Rec.Class != agiru::platform::FieldClass::Normal) {
      return 1;
    }
    agiru::Text<30> target;
    first.Read(target);
    if (target.Value() != "First") { return 1; }
    second.Read(target);
    if (target.Value() != "Second") { return 1; }
    if (!first.TemporaryStatus() || first.RowCount() != 0) { return 1; }
    if (first.CurrentGroup() != 0 || second.CurrentGroup() != 0) { return 1; }
    first.SetNameFilter("Group zero");
    if (first.SelectGroup(2) != 0 || first.CurrentGroup() != 2 ||
        second.CurrentGroup() != 0 || first.PreviousGroup() != 0) {
      return 1;
    }
    if (!first.ReadNameFilter().Value().empty()) { return 1; }
    first.SetNameFilter("Group two");
    if (first.ReadNameFilter().Value() != "Group two") { return 1; }
    if (first.IgnoreLargeGroup() != 2 || first.ReadNameFilter().Value() != "Group two") { return 1; }
    if (first.ReflectedGroups() != 11 || first.CurrentGroup() != 2 ||
        first.ReadNameFilter().Value() != "Group two") {
      return 1;
    }
    if (first.SelectGroup(0) != 2 || first.ReadNameFilter().Value() != "Group zero") { return 1; }
    if (second.SelectGroup(4) != 0 || second.CurrentGroup() != 4 || first.CurrentGroup() != 0) {
      return 1;
    }
    if (first.LocalNameFilter().Value() != "Local" || first.ReadNameFilter().Value() != "Group zero") {
      return 1;
    }
    return 0;
  } catch (const std::exception &error) {
    std::fputs(error.what(), stderr);
    return 1;
  }
}
