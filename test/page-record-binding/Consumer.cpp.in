#include "fixture/page/RecordBinding.h"
#include "platform/Field.h"
#include "type/Text.h"

#include <cstdio>
#include <exception>

int main() {
  try {
    agiru::Fixture::RecordBinding_Page first;
    agiru::Fixture::RecordBinding_Page second;
    first.Rec.TableName = "First";
    second.Rec.TableName = "Second";
    if (first.Choose() != 2 || first.Rec.Class != agiru::platform::FieldClass::FlowFilter) {
      return 1;
    }
    if (first.ChooseWithShadow() != 1 || first.Rec.Class != agiru::platform::FieldClass::FlowField) {
      return 1;
    }
    if (first.ChoosePrevious() != 0 || first.Rec.Class != agiru::platform::FieldClass::Normal) {
      return 1;
    }
    agiru::Text<30> target;
    first.Read(target);
    if (target.Value() != "First") { return 1; }
    second.Read(target);
    if (target.Value() != "Second") { return 1; }
    return 0;
  } catch (const std::exception &error) {
    std::fputs(error.what(), stderr);
    return 1;
  }
}
