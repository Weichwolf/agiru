# clangd reads `compile_commands.json` at the root. `make db` puts it there (a symlink into the
# build tree) and it is gitignored -- the one exception to artefacts staying out of the tree.
#
# What stands here is only what the compilation database cannot say: the generated tree under
# src/app/ is machine output. clangd should be able to open it but show no diagnostics inside,
# otherwise every jump into a generated file drowns in findings with no address.
Diagnostics:
  UnusedIncludes: Strict
  MissingIncludes: Strict

---
If:
  PathMatch: .*/src/app/.*
Diagnostics:
  Suppress: '*'
