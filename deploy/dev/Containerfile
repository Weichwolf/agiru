FROM docker.io/library/debian:trixie-slim@sha256:918311b7b6c4c6f68b232ba516584925f6c78ad82b6fd534b98979df6438e483

ARG DEV_UID=1000
ARG DEV_GID=1001
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates clang-19 clang-format-19 clang-tidy-19 lld-19 \
    libc++-19-dev libc++abi-19-dev libunwind-19-dev libclang-rt-19-dev \
    cmake ninja-build ccache make python3 git curl unzip jq ripgrep \
    libpq-dev postgresql-17 libxml2-dev libyyjson-dev libssl-dev libmicrohttpd-dev pkg-config util-linux tini \
    && apt-get clean
RUN apt-get install -y --no-install-recommends iproute2 && apt-get clean
RUN set -eu; \
    architecture=$(dpkg --print-architecture); \
    case "$architecture" in \
      amd64) checksum=a7a433a1b133efc3c8d10eb0b99d52a24b5ef5c322dc77f5282182b1c0402139ab83f3a99f0c52409df77d20123fb0b523edad8a66d8f5e49136197bf61ef0e7 ;; \
      arm64) checksum=3db36ba90c7a6e8dda40ee3dd71fa08844c76b5fb08f61b31e5e78d2ed38e71c51dc7baed875e50d1ca1279196e84302967237386ae87c91ae9f2aaceada682e ;; \
      *) printf 'Unsupported Caddy architecture: %s\n' "$architecture" >&2; exit 1 ;; \
    esac; \
    curl --fail --location --silent --show-error \
      "https://github.com/caddyserver/caddy/releases/download/v2.11.7/caddy_2.11.7_linux_${architecture}.tar.gz" \
      --output /tmp/agiru-caddy.tar.gz; \
    printf '%s  /tmp/agiru-caddy.tar.gz\n' "$checksum" | sha512sum --check; \
    tar -xzf /tmp/agiru-caddy.tar.gz -C /usr/local/bin caddy; \
    install -d /usr/share/doc/caddy; \
    tar -xzf /tmp/agiru-caddy.tar.gz -C /usr/share/doc/caddy LICENSE README.md; \
    rm /tmp/agiru-caddy.tar.gz; \
    caddy version
RUN groupadd --gid "$DEV_GID" agiru \
    && useradd --uid "$DEV_UID" --gid "$DEV_GID" --create-home agiru
COPY entrypoint.sh /usr/local/bin/agiru-dev-entrypoint
COPY Caddyfile /etc/agiru/Caddyfile
RUN chmod 755 /usr/local/bin/agiru-dev-entrypoint
ENV PGDATA=/var/lib/agiru/postgres \
    PATH=/usr/lib/postgresql/17/bin:$PATH \
    CCACHE_DIR=/home/agiru/.cache/ccache \
    XDG_DATA_HOME=/var/lib/agiru/caddy/data \
    XDG_CONFIG_HOME=/var/lib/agiru/caddy/config
WORKDIR /workspace
EXPOSE 8080 8443
HEALTHCHECK --interval=5s --timeout=3s --start-period=30s \
    CMD pg_isready -h 127.0.0.1 -p 5432 -U agiru -d agiru_gate
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/agiru-dev-entrypoint"]
CMD ["database-only"]
