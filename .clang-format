# AN EXEMPLARY STYLE, NOT THIS TREE'S HABITS. The tree is empty; there is no habit to fit, and that
# is the cheapest moment a formatting contract ever gets. Everything here is chosen so that
# unfamiliar code READS well.
#
# WHY 100 AND NOT 80. This tree's names are its documentation -- `Record`, `FieldNo`,
# `TableRelation`, `ValidateOnAfterValidate` -- and a limit that wraps a two-name expression costs
# more in broken lines than it saves in width.
BasedOnStyle: LLVM
Standard: c++20
ColumnLimit: 100
IndentWidth: 2
AccessModifierOffset: -2
PointerAlignment: Right
DerivePointerAlignment: false
QualifierAlignment: Left
LineEnding: LF
InsertNewlineAtEOF: true

# BRACES ALWAYS, AND THE FORMATTER PUTS THEM THERE. A braceless `if` that grows a second statement
# is one of the few edits that changes meaning silently, and it is unspellable once this is on.
InsertBraces: true

# AND A ONE-LINE BODY STAYS ON ONE LINE, braces and all. `if (!ok) { return false; }` is a guard
# read at a glance; spread over three lines it is a paragraph, and a function with six guards
# becomes a page.
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortBlocksOnASingleLine: Always
AllowShortLoopsOnASingleLine: true
AllowShortCaseLabelsOnASingleLine: true

# A FREE FUNCTION IS NEVER ONE LINE. An accessor inside a class is a name for a member and reads as
# one; a definition at namespace scope is a thing a reader looks for, and it is found by its line.
AllowShortFunctionsOnASingleLine: Inline

# ONE BLANK LINE BETWEEN DEFINITIONS, always, so the eye finds a boundary without counting braces.
SeparateDefinitionBlocks: Always
MaxEmptyLinesToKeep: 1

BreakBeforeBraces: Attach
SpacesBeforeTrailingComments: 1
IndentCaseLabels: true
IndentPPDirectives: None

# ARGUMENTS ARE NOT PACKED. A call that does not fit puts ONE argument per line, so adding one is a
# one-line diff instead of a reflowed paragraph.
BinPackArguments: false
BinPackParameters: false
AlignAfterOpenBracket: Align
PackConstructorInitializers: NextLine

# INCLUDES ARE SORTED, because the tree is new. In a grown tree a regroup finds headers that are
# not self-contained and is therefore a repair rather than a format; here there are none yet, so the
# rule costs nothing from today on.
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  # THE DOOR COMES FIRST IN EVERY GENERATED FILE, AS ITS OWN BLOCK. It used to be one header and
  # one pattern; it is now the set a file actually names, so the pattern is the door's DIRECTORIES.
  # Without it `Regroup` merges the door with the objects the file includes and sorts the two
  # together, which reads as one undifferentiated list -- and they are two different kinds of
  # dependency, the way AL separates `namespace` from `using`.
  - Regex: '^"(Builtins\.h|meta/|runtime/|type/|platform/|dotnet/|absent/)'
    Priority: 1
  - Regex: '^"'
    Priority: 2
  - Regex: '^<(libpq-fe|postgres)'
    Priority: 4
  - Regex: '^<[a-z_]+>$'
    Priority: 3
  - Regex: '.*'
    Priority: 5
