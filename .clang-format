# EIN VORBILDLICHER STIL, NICHT DIE GEWOHNHEIT DIESES BAUMS. Der Baum ist leer; es gibt keine
# Gewohnheit, an die anzupassen waere, und das ist der guenstigste Moment, den ein Formatvertrag je
# hat. Alles hier ist gewaehlt, damit fremder Code gut LIEST.
#
# WARUM 100 UND NICHT 80. Die Namen dieses Baums sind seine Dokumentation — `Record`,
# `FieldNo`, `TableRelation`, `ValidateOnAfterValidate` — und eine Grenze, die einen Ausdruck aus
# zwei Namen umbricht, kostet mehr an gebrochenen Zeilen, als sie an Breite spart.
BasedOnStyle: LLVM
Standard: c++20
ColumnLimit: 100
IndentWidth: 2
AccessModifierOffset: -2
PointerAlignment: Right
DerivePointerAlignment: false
QualifierAlignment: Left
LineEnding: LF
InsertNewlineAtEOF: true

# KLAMMERN IMMER, UND DER FORMATIERER SETZT SIE. Ein klammerloses `if`, das eine zweite Anweisung
# bekommt, ist eine der wenigen Aenderungen, die Bedeutung still veraendern — mit dieser Zeile ist
# sie nicht mehr schreibbar.
InsertBraces: true

# UND EIN EINZEILER BLEIBT EINZEILIG, Klammern und alles. `if (!ok) { return false; }` ist eine
# Wache, die man auf einen Blick liest; ueber drei Zeilen ist sie ein Absatz, und eine Funktion mit
# sechs Wachen wird eine Seite.
AllowShortIfStatementsOnASingleLine: AllIfsAndElse
AllowShortBlocksOnASingleLine: Always
AllowShortLoopsOnASingleLine: true
AllowShortCaseLabelsOnASingleLine: true

# EINE FREIE FUNKTION IST NIE EINZEILIG. Ein Accessor in einer Klasse ist ein Name fuer ein Member
# und liest sich als einer; eine Definition auf Namespace-Ebene ist etwas, das ein Leser SUCHT, und
# er findet sie an ihrer Zeile.
AllowShortFunctionsOnASingleLine: Inline

# EINE LEERZEILE ZWISCHEN DEFINITIONEN, immer, damit das Auge eine Grenze findet, ohne Klammern zu
# zaehlen.
SeparateDefinitionBlocks: Always
MaxEmptyLinesToKeep: 1

BreakBeforeBraces: Attach
SpacesBeforeTrailingComments: 1
IndentCaseLabels: true
IndentPPDirectives: None

# ARGUMENTE WERDEN NICHT GEPACKT. Ein Aufruf, der nicht passt, setzt EIN Argument je Zeile — eines
# hinzuzufuegen ist dann ein Einzeiler-Diff statt eines umflossenen Absatzes.
BinPackArguments: false
BinPackParameters: false
AlignAfterOpenBracket: Align
PackConstructorInitializers: NextLine

# DIE INCLUDES WERDEN SORTIERT, weil der Baum neu ist. In einem gewachsenen Baum findet eine
# Neusortierung Header, die nicht selbststaendig sind, und ist deshalb eine Reparatur und kein
# Format; hier gibt es die noch nicht, also kostet die Regel ab heute nichts.
SortIncludes: CaseSensitive
IncludeBlocks: Regroup
IncludeCategories:
  - Regex: '^"agiru/'
    Priority: 1
  - Regex: '^"'
    Priority: 2
  - Regex: '^<(libpq-fe|postgres)'
    Priority: 4
  - Regex: '^<[a-z_]+>$'
    Priority: 3
  - Regex: '.*'
    Priority: 5
